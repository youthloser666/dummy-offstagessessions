# =======================================================
# OFFSTAGE SESSIONS — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your credentials
# =======================================================

# -------------------------------------------------------
# 1. SUPABASE (Database & Auth)
# Get these from: Supabase Dashboard > Project Settings > API
# -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service Role Key (Keep secret! Used only on server-side / API routes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# -------------------------------------------------------
# 2. CLOUDINARY (Media Storage & Transformations)
# Get these from: Cloudinary Dashboard > Programmable Media
# -------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# -------------------------------------------------------
# 3. BEHOLD (Instagram Feed API)
# Get this from: behold.so dashboard
# -------------------------------------------------------
NEXT_PUBLIC_BEHOLD_FEED_URL=https://feeds.behold.so/sRkAEKqjRO8V5cW8pZDt

# -------------------------------------------------------
# 4. ADMIN ACCESS (/offstageadminv)
# Secret passkey for managing shows, media, and inquiries
# -------------------------------------------------------
ADMIN_SECRET_PASSKEY=offstage-session-admin-2026
